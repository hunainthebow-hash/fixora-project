# Server-only secrets. NEVER put these in VITE_* variables.
DATABASE_URL=postgresql://fixora_app:CHANGE_ME@localhost:5432/fixora
DATABASE_SSL=true
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Leave empty when frontend and backend use the same Fixora server
VITE_API_BASE_URL=

# Safepay Payment Gateway (Pakistan PKR Payments & Wallets)
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
VITE_SAFEPAY_PUBLIC_KEY=sec_sandbox_fixora_test_key
SAFEPAY_ENVIRONMENT=sandbox

